# ---------------------------------------------------------------------------
# LBV Sales Engine - LOCAL development environment example
#
# Copy this file to `.env` for LOCAL development only (npm run dev, npm run test:*).
#
# IMPORTANT: In production these values are NOT read from a .env file. They are
# Cloudflare Worker *secrets* (sensitive) and *vars* (non-sensitive) configured
# via `wrangler secret put` or the Cloudflare dashboard. See DEPLOYMENT.md.
#
# NEVER commit real secrets. Leave secret values empty here.
# ---------------------------------------------------------------------------

# --- LLM provider (Groq is the default) ------------------------------------
# Required in production as a Worker secret (default provider).
GROQ_API_KEY=""
# Optional. "groq" (default) or "gemini".
LLM_PROVIDER="groq"
# Optional. Overrides the provider default model (Groq default: llama-3.1-8b-instant).
LLM_MODEL=""
# Optional. Request timeout in milliseconds (default 20000).
LLM_TIMEOUT_MS="20000"

# --- Optional token budget (0 or unset disables enforcement) ---------------
LBV_MAX_TOTAL_TOKENS="0"
LBV_MAX_REQUEST_TOKENS="0"

# --- Gemini (only needed when LLM_PROVIDER=gemini, or for the live
#     adversarial/stage2/classification suites) -----------------------------
GEMINI_API_KEY=""

# --- LiveKit realtime (required for the realtime copilot) ------------------
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# --- Admin-protected internal test/evaluation endpoints --------------------
ADMIN_API_KEY=""

# --- CORS: comma-separated approved origins --------------------------------
# In production, empty/unset means deny all origins (fail closed).
ALLOWED_ORIGINS="http://localhost:3000"

# --- Environment -----------------------------------------------------------
# In a Cloudflare Worker, an ABSENT NODE_ENV is treated as production
# (fail-closed). Set this to "development" for local work only.
NODE_ENV="development"
