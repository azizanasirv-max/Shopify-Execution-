# ---------------------------------------------------------------------------
# TEMPLATE ONLY - do not rename this file to livekit.toml by hand.
#
# LiveKit Cloud identifies an agent by the ID issued when the agent is FIRST
# registered. That ID (and the project subdomain) cannot be guessed, so the real
# `agent/livekit.toml` must be generated by LiveKit Cloud itself.
#
# Generate it with EITHER:
#   1. The GitHub Actions workflow `.github/workflows/deploy-agent.yml`
#      (Actions -> "Deploy LiveKit Agent" -> Run workflow -> operation: create),
#      which registers the agent and opens a PR containing the generated file, or
#   2. The LiveKit CLI from inside this directory: `lk cloud auth && lk agent create`
#      (requires the LiveKit CLI, https://docs.livekit.io/reference/developer-tools/livekit-cli/).
#
# Until `agent/livekit.toml` exists, `livekit/deploy-action` cannot deploy:
# the `deploy` operation exits with "livekit.toml not found".
# ---------------------------------------------------------------------------

[project]
  # Subdomain of the LiveKit Cloud project that owns the agent,
  # e.g. for wss://my-project.livekit.cloud this is "my-project".
  subdomain = "<your-livekit-cloud-project-subdomain>"

[agent]
  # Agent ID issued by LiveKit Cloud on first registration.
  id = "<agent-id-from-livekit-cloud>"
  # Optional: pin the agent to specific LiveKit Cloud regions.
  # regions = ["us-east"]
