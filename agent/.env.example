# ---------------------------------------------------------------------------
# LBV LiveKit Agent - environment (run OUTSIDE Cloudflare Workers)
#
# Copy to `agent/.env.local` and fill in. NEVER commit real values.
# This agent is a long-running process (not a Worker): it joins a LiveKit room,
# streams room audio to the direct AssemblyAI API, and publishes transcription
# events back into the room.
# ---------------------------------------------------------------------------

# --- LiveKit (required) ---
# Same project as the Worker. Use the same key/secret or a dedicated agent key.
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# --- AssemblyAI direct API (required for STT) ---
# Obtained from https://www.assemblyai.com/dashboard (free tier available).
# This key is used ONLY by the agent process, never by the browser or the Worker.
ASSEMBLYAI_API_KEY=""

# --- Agent behaviour (optional) ---
# Room to join when not dispatched by a LiveKit agent dispatch rule.
# Leave empty when using automatic dispatch (agent joins every new room).
LIVEKIT_AGENT_ROOM=""
# AssemblyAI speech model. Leave empty to use the pinned default in agent.ts
# (universal-streaming-english). NOTE: the installed plugin's own default is
# universal-3-5-pro (a U3-Pro model), which is NOT what this project documents
# and is not guaranteed to be entitled on your AssemblyAI account; an unentitled
# model makes AssemblyAI reject the streaming WebSocket and produces ZERO
# transcription. Set this only to a model your account is entitled to.
ASSEMBLYAI_SPEECH_MODEL=""
